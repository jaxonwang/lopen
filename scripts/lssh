#!/bin/sh
# lssh - ssh one hop deeper while extending the lopen tunnel.
#
# Usage: lssh <ssh args...>       (exactly like ssh)
#
# lopen's reverse tunnel terminates in a loopback TCP port on THIS host
# (127.0.0.1:<port>, read from ~/.lopen/agent.json). lssh extends the chain to
# the next hop by:
#   1. copying this host's ~/.lopen/agent.json to the target (so `lopen` there
#      learns the same label/port/token), and
#   2. forwarding the target's 127.0.0.1:<port> back to this host's port with
#      `ssh -R`.
#
# The request from the far side then relays hop-by-hop back to your Mac and is
# attributed to the nearest directly-enrolled host's label — the honest
# identity the daemon can attest to.
#
# The last argument that does not look like an option is assumed to be the
# destination (good enough for `lssh host` / `lssh user@host`; for exotic ssh
# invocations forward the port yourself).
set -eu

AGENT="$HOME/.lopen/agent.json"
if [ ! -f "$AGENT" ]; then
    echo "lssh: no agent config at $AGENT; is the lopen tunnel to this host up?" >&2
    exit 1
fi

# Extract the port from the JSON agent config without requiring jq.
PORT=$(sed -n 's/.*"port"[[:space:]]*:[[:space:]]*\([0-9]\{1,\}\).*/\1/p' "$AGENT")
if [ -z "$PORT" ]; then
    echo "lssh: could not read port from $AGENT" >&2
    exit 1
fi

dest=""
for arg in "$@"; do
    case "$arg" in
        -*) ;;
        *) dest="$arg" ;;
    esac
done

if [ -n "$dest" ]; then
    # Copy this host's agent config to the target so `lopen` there authenticates
    # with the same token, then loopback-forward the port on connect.
    ssh -o BatchMode=yes -- "$dest" \
        'umask 077 && mkdir -p ~/.lopen && chmod 700 ~/.lopen && cat > ~/.lopen/agent.json.tmp && chmod 600 ~/.lopen/agent.json.tmp && mv -f ~/.lopen/agent.json.tmp ~/.lopen/agent.json' \
        < "$AGENT" 2>/dev/null || true
fi

exec ssh -o ExitOnForwardFailure=yes -R "127.0.0.1:$PORT:127.0.0.1:$PORT" "$@"
